#
# wm independent hotkeys
#

# terminal emulator
super + Return
	   kitty

# Open editor
super + c
    cblt

# rofi
super + grave
    	rofi -show drun \
         -p "> " \
         -mesg "[ LAUNCH ]" \
         -theme ~/.config/rofi/peakyArch.rasi

# reload bspwm
super + shift + r
	   bspc wm -r

# make sxhkd reload its configuration files:
super + Escape
	   pkill -USR1 -x sxhkd

